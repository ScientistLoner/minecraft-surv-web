{
  // Whether HYW unit arrows render the extra full-charge crit trail on this client
  "enableUnitArrowTrails": true,
  // Whether team indicators render when the crosshair is looking at a unit within command pick distance
  "renderTeamIndicatorOnLookedAtEntity": true,
  // Whether spoiler-protected creative tab entries are hidden until discovered on this client
  "enableSpoilerProtection": true,
  // Whether repeated overlay messages show a counter suffix on this client
  "enableRepeatedMessageCounter": true,
  // Whether this client may download and use cached remote custom skins
  "enableRemoteSkinDownloads": true,
  // Whether shortcut hints are shown while RTS camera mode is active
  "showRtsKeyHints": true
}
